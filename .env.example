# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional server-only secret; never expose through NEXT_PUBLIC_.
# Not used by this release: all reads and the reward RPC use the user's session.
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY

# Server-only key that encrypts payout account details (AES-256-GCM): 32 random bytes, base64.
# Generate with: openssl rand -base64 32. Without it, payout requests fail closed.
# PAYOUT_DETAILS_KEY=

NEXT_PUBLIC_APP_NAME=Virtual Earn
# Used to build auth email redirect links. Must match an allowed redirect URL in Supabase Auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database tests only: a disposable PostgreSQL superuser connection.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
